bacc:0000008 a skos:Concept ;
    oboInOwl:hasExactSynonym "lab strain"@en ;
    skos:altLabel "lab strain"@en ;
    skos:definition "A bacterial strain that was kept, evolved, or engineered in a laboratory."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:notation "BACC:0000008" ;
    skos:prefLabel "laboratory strain"@en ;
    skos:scopeNote "Not for a new isolate from a natural or clinical source. Wording about culture, medium, plate, isolate, or a diagnostic laboratory does not qualify."@en ;
    skos:topConceptOf <https://w3id.org/baccurate/vocabulary> .

