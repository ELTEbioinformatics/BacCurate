baccv:part_of rdfs:label "part of"@en ;
    rdfs:subPropertyOf skos:related ;
    skos:definition "The site is part of a second whole outside its parent path."@en .

baccv:produced_by rdfs:label "produced by"@en ;
    rdfs:subPropertyOf skos:related ;
    skos:definition "The site produces the material."@en .

baccv:sampled_object a skos:Collection ;
