bacc:0000005 a skos:Concept ;
    dcterms:isReplacedBy bacc:0000004 ;
    owl:deprecated true ;
    skos:historyNote "Obsolete since 2026-10-12. The source type does not separate built and natural environments."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:prefLabel "built environment"@en .

bacc:0000006 a skos:Concept ;
    dcterms:isReplacedBy bacc:0000004 ;
    owl:deprecated true ;
    skos:historyNote "Obsolete since 2026-10-12. The source type does not separate built and natural environments."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:prefLabel "natural environment"@en .

bacc:0000023 a skos:Concept ;
    dcterms:isReplacedBy bacc:0000022,
        bacc:0000039 ;
    owl:deprecated true ;
    skos:historyNote "Obsolete since 2026-10-12. The content and its site are two terms in two facets."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:prefLabel "intestinal content"@en .

bacc:0000024 a skos:Concept ;
