bacc:0000078 a skos:Concept ;
    owl:deprecated true ;
    skos:historyNote "Obsolete since 2026-10-12. A biofilm is a growth form, not a source. The terms of its place describe a real biofilm."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:prefLabel "biofilm"@en .

bacc:0000081 a skos:Concept ;
    owl:deprecated true ;
    skos:historyNote "Obsolete since 2026-10-12. Sampling inside a laboratory is rare. Most of its records named a laboratory that handled the isolate."@en ;
    skos:inScheme <https://w3id.org/baccurate/vocabulary> ;
    skos:prefLabel "laboratory facility"@en .

